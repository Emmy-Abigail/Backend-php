APP_ENV=development
API_PORT=8081

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=riva
DB_USERNAME=riva
DB_PASSWORD=riva_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=root_password

INITIAL_ADMIN_NOMBRES=Administrador
INITIAL_ADMIN_CORREO=admin@email.com
INITIAL_ADMIN_PASSWORD="Admin2026#Seguro"

JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_MINIMO_32_CARACTERES
JWT_ISSUER=gestion-envios-api
JWT_TTL_SECONDS=28800

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=PEGA_AQUI_TU_CONTRASENA_DE_APLICACION_DE_GOOGLE
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="Sistema de Gestion de Envios"

# Opcional: URL del frontend. Si se omite, el correo contiene solo el token.
PASSWORD_RESET_URL=http://localhost:4200/restablecer
FRONTEND_URL=http://localhost:4200

# Python publica el puerto 8015.
# El precio se calcula en PHP con la tarifa vigente; Python decide la asignacion.
ASSIGNMENT_SERVICE_URL=http://host.docker.internal:8015
ASSIGNMENT_API_KEY=REEMPLAZAR_POR_LA_MISMA_API_KEY_DE_PYTHON
ASSIGNMENT_TIMEOUT_SECONDS=3

# Opcional: el despacho de lotes pide la ruta al mismo servicio de Python que la asignacion.
# Solo hace falta definir estas variables si la ruta usa otro servicio, otra clave u otro timeout.
# ROUTE_SERVICE_URL=http://host.docker.internal:8015
# ROUTE_API_KEY=REEMPLAZAR_POR_LA_API_KEY_DE_PYTHON
# ROUTE_TIMEOUT_SECONDS=3
